<?xml version="1.0" encoding="utf-8"?>
<!-- The window shown while the process starts. Its ground has to
     match the scheme the app is about to paint, or the launch
     flashes the opposite colour for a frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:gravity="center" android:drawable="@drawable/ic_launch_image" />
</layer-list>
