# PLACEHOLDER VALUES ONLY - NO REAL CREDENTIALS.
# The prototype (lib/main_demo.dart) never reads these; it has no network path
# at all. They exist purely so envied codegen can run, because app_ui imports
# shared, which imports env. Replace with real values only if you intend to
# start the original Instagram app against Supabase and PowerSync.
SUPABASE_URL=https://placeholder.invalid
SUPABASE_ANON_KEY=placeholder-anon-key
POWERSYNC_URL=https://placeholder.invalid
FCM_SERVER_KEY=placeholder-fcm-server-key
IOS_CLIENT_ID=placeholder-ios-client-id
WEB_CLIENT_ID=placeholder-web-client-id
